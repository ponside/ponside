# Required public canonical URL (for metadata and same-origin production configuration)
NEXT_PUBLIC_SITE_URL=https://ponside.fun

# Required Privy X login and embedded-wallet configuration
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Required Supabase project URL and server-only service role key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required standard Robinhood Chain RPC for verification and application reads
ROBINHOOD_RPC_URL=https://your-robinhood-chain-rpc.example
# Optional diagnostic/forward-event indexer configuration. Market discovery does
# not depend on either value or on historical archive access.
ROBINHOOD_INDEXER_RPC_URL=https://your-archive-robinhood-chain-rpc.example
INDEXER_SECRET=your_random_indexer_secret
# Required server-only bearer secret used by the five-minute Supabase Cron refresh.
PONS_DISCOVERY_REFRESH_SECRET=your_random_discovery_refresh_secret

# Current Pons V2 production contracts (official defaults shown)
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_V2_LAUNCH_AND_BUY_ADDRESS=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# Optional official token pin. Leave empty to keep the feature completely hidden.
PONSIDE_FEATURED_TOKEN_ADDRESS=

# Optional overrides; these defaults match the migration and verified deployment start block
SUPABASE_POST_MEDIA_BUCKET=post-media
SUPABASE_TOKEN_LOGO_BUCKET=token-logos
PONS_V2_DEPLOYMENT_BLOCK=26841846
INDEXER_BLOCK_CHUNK_SIZE=2000
INDEXER_MAX_CHUNKS_PER_RUN=20
INDEXER_CONFIRMATIONS=12
# Delay between completed historical chunks. Keep conservative for free-tier archive RPCs.
INDEXER_CHUNK_DELAY_MS=1000
